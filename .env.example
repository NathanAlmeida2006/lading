# ID numérico PÚBLICO do Meta Pixel (Gerenciador de Eventos). Nunca coloque token da API de Conversões (EAA...) aqui.
VITE_META_PIXEL_ID=
# ID do projeto no Microsoft Clarity (painel > Settings > Overview).
# Em producao o .env NAO vai junto (esta no .gitignore): cadastre VITE_CLARITY_ID e VITE_META_PIXEL_ID no Cloudflare
# (Workers & Pages > projeto > Settings > Variables and Secrets > BUILD variables) e faca um novo deploy: o Vite embute o valor no build.
VITE_CLARITY_ID=
# Pixel e Clarity só carregam no build de producao; 1 liga no `npm run dev` para testar.
VITE_ENABLE_PIXEL_DEV=

# Chave pública e host de ingestão do PostHog. Configure os mesmos valores nas BUILD variables do Cloudflare em produção.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
