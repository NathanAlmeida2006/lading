# ID numérico PÚBLICO do Meta Pixel (Gerenciador de Eventos). Nunca coloque token da API de Conversões (EAA...) aqui.
VITE_META_PIXEL_ID=
# ID do projeto no Microsoft Clarity (painel > Settings > Overview).
VITE_CLARITY_ID=
# Pixel e Clarity só carregam no build de producao; 1 liga no `npm run dev` para testar.
VITE_ENABLE_PIXEL_DEV=
