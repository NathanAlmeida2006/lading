{
  "name": "fluor-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing page do Projeto Fluor.",
  "scripts": {
    "sync:ds": "node scripts/sync-ds.mjs",
    "dev": "vite",
    "build": "vite build && vite build -c vite.documents.config.js && vite build --ssr src/entries/server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-size.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "lenis": "^1.3.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "1.44.1",
    "posthog-js": "^1.453.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "22.23.3"
  }
}
