{
  "name": "fluor-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing page do Projeto Fluor.",
  "scripts": {
    "sync:ds": "node scripts/sincronizar-ds.mjs",
    "dev": "vite",
    "build": "vite build && vite build -c vite.documentos.config.js && vite build --ssr src/entradas/servidor.jsx --outDir dist-ssr && node scripts/prerenderizar.mjs && node scripts/verificar-tamanho.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/testes/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "size": "node scripts/verificar-tamanho.mjs"
  },
  "dependencies": {
    "animejs": "^4.0.2",
    "lenis": "^1.3.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "1.44.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  },
  "volta": {
    "node": "22.23.3"
  }
}
