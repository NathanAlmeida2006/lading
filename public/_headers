/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-kqYwCxAmG6mQrfjuOJZ+TS5qnFs8n/fwDE6cKIYSNGM=' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com; connect-src 'self' https://www.facebook.com; font-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fontes/*
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=86400

/*.mp3
  Cache-Control: public, max-age=86400

/modelos-3d/*
  Cache-Control: public, max-age=86400

/documentos/*
  Cache-Control: public, max-age=31536000, immutable
